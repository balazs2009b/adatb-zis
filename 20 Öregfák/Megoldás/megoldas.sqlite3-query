-- ==========================================================
-- 20. Magyarország öreg fái
-- ==========================================================
-- fa(azon, faj, kormeret, telepules, megyeid, meres)   1257 sor
--   kormeret centiméterben, meres = a mérés éve
--   megyeid -> megye.id
-- megye(id, nev)                                         19 sor

-- --- 3. feladat -------------------------------------------
-- 900 cm-nél nagyobb körméret, az érték MÉTERBEN, 2 tizedesre.
-- A 100.0 azért fontos, mert a 100 egész osztást adna (pl. 10 helyett
-- 10.13 kellene). A round(mit, jegyek) a kerekítés.
SELECT faj, round(kormeret/100.0, 2) AS kormeret_m
FROM fa
WHERE kormeret > 900
ORDER BY faj;
-- Eredmény: 18 fa. A legvastagabbak a nyárak és a hársak,
-- pl. fehér nyár 10.13 m, fekete nyár 9.96 m.

-- --- 4. feladat -------------------------------------------
SELECT faj, kormeret, meres
FROM fa
ORDER BY kormeret DESC
LIMIT 1;
-- Eredmény: kislevelű hárs, 1103 cm (11,03 m), 2003-ban mérve.

-- --- 5. feladat -------------------------------------------
-- Településenként a fák száma. Két szempont szerinti rendezés:
-- elsődlegesen darabszám csökkenően, holtverseny esetén
-- településnév ábécérendben.
SELECT telepules, count(*) AS db
FROM fa
GROUP BY telepules
ORDER BY db DESC, telepules;
-- Eredmény: 412 település. Az élen: Gemenc 57, Monostorapáti 52,
-- Püspökszentlászló 33, Bükkszentkereszt 32, Pénzesgyőr 26.

-- --- 6. feladat -------------------------------------------
SELECT megye.nev, count(*) AS db
FROM fa
JOIN megye ON fa.megyeid = megye.id
GROUP BY megye.nev;
-- Eredmény: mind a 19 megye szerepel. A legtöbb adat Baranyából
-- (142) és Borsod-Abaúj-Zemplénből (120) van.

-- --- 7. feladat -------------------------------------------
-- Azok a fajok, amelyek olyan településen állnak, ahol tiszafa is van.
-- A tiszafa maga nem szerepelhet, és minden fajnév csak egyszer
-- -> DISTINCT. A települések halmazát segédlekérdezés adja -> IN.
SELECT DISTINCT faj
FROM fa
WHERE telepules IN (SELECT telepules FROM fa WHERE faj = 'tiszafa')
  AND faj <> 'tiszafa';
-- Az adatbázisban 2 tiszafa van. Eredmény: 7 fajnév -
--   fűz, fekete nyár, zöld juhar, kocsányos tölgy,
--   fehér fűz, vénic szil, korai juhar
