-- 4. Rendezés és számított mezők
-- ==========================================================

-- --- B. Rendezés ------------------------------------------
SELECT * FROM evek ORDER BY szuletett;

-- Babits Mihály és Juhász Gyula ugyanabban az évben született: 1883-ban.
SELECT * FROM evek ORDER BY szuletett,meghalt;

SELECT * FROM evek ORDER BY nev DESC;

-- --- C. Helyezés ------------------------------------------
SELECT * FROM evek ORDER BY szuletett LIMIT 3;
-- Eredmény: Kölcsey Ferenc (1790), Arany János (1817), Petőfi Sándor (1823)

-- --- D. Indexelés -----------------------------------------
CREATE INDEX IF NOT EXISTS idx_szul ON evek(szuletett);

SELECT * FROM evek ORDER BY szuletett;

-- --- E. Két érték közötti szűrés --------------------------
-- Első megoldás:
SELECT * FROM evek WHERE meghalt BETWEEN 1919 AND 1944 ORDER BY meghalt;

-- Második megoldás (ugyanaz az eredmény):
SELECT * FROM evek WHERE meghalt>=1919 AND meghalt<=1944 ORDER BY meghalt;
-- Eredmény: Ady 1919, Tóth Árpád 1928, József Attila 1937,
--           Juhász Gyula 1937, Babits 1941, Radnóti 1944

-- --- F. Üres mezők ----------------------------------------
SELECT * FROM masolat WHERE hely IS NULL;
SELECT * FROM masolat WHERE hely IS NOT NULL;

UPDATE masolat SET hely='nincs adat' WHERE hely IS NULL;

-- --- G. Számított mezők -----------------------------------
SELECT nev,meghalt-szuletett FROM evek;

SELECT nev AS Név,meghalt-szuletett AS Év FROM evek;


-- ==========================================================
-- H. Feladatok - megoldások
-- ==========================================================

-- 1. feladat: a leghosszabb ideig élt költő neve és kora
SELECT nev AS Név, meghalt-szuletett AS Kor
FROM evek
ORDER BY Kor DESC
LIMIT 1;
-- Eredmény: Illyés Gyula, 81 év

-- 2. feladat: Petőfi Sándor születési helyének javítása Kiskőrösre
UPDATE masolat SET hely='Kiskőrös' WHERE nev='Petőfi Sándor';

SELECT nev, hely FROM masolat;
