-- 31. Budapesti trolibusz-halozat
-- ==========================================================
-- megallok(id, nev)                        197 + 1 sor
-- jaratok(id, jaratSzam, jaratTipus, elsoAjtos)   20 sor
--   elsoAjtos: 1 = igaz, 0 = hamis (logikai)
-- halozat(jarat, megallo, irany, sorszam)        587 sor
--   Egy jarat egy megalloja egy iranyban = egy sor.

-- --- 12. feladat ------------------------------------------
