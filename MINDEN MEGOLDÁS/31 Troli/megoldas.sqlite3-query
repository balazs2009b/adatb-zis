-- --- 15. feladat ------------------------------------------
-- "setany" szora vegzodik -> a % a szo ELE kerul.
SELECT nev FROM megallok WHERE nev LIKE '%sétány' ORDER BY nev;
-- Eredmeny: 3 megallo - Dvorak setany, Kos Karoly setany,
--           Olof Palme setany. A minta elso ketto sora egyezik.

-- --- 16. feladat ------------------------------------------
SELECT halozat.sorszam AS sorszam, megallok.nev AS megallo
FROM halozat
JOIN jaratok ON halozat.jarat = jaratok.id
JOIN megallok ON halozat.megallo = megallok.id
WHERE jaratok.jaratSzam = 'CITY' AND halozat.irany = 'A'
ORDER BY halozat.sorszam;
-- Eredmeny: 13 megallo. A minta harom sora pontosan egyezik:
--   1 Fovam ter M, 2 Kalvin ter M, 3 Ferenciek tere M.

-- --- 17. feladat ------------------------------------------
-- !!! ELLENTMONDAS A FELADAT SZOVEGE ES A MINTA KOZOTT !!!
--
-- A feladat szovege szerint azok a megallok kellenek, ahol legalabb
-- 3 KULONBOZO JARATRA lehet felszallni. Ez a count(DISTINCT jarat)
-- lenne. A feladatlap mintaja viszont mast mutat:
--
--   Akacfa utca                      4
--   Andrassy ut (Opera M)            4
--   Andrassy ut (Vorosmarty utca M)  4
--
-- Az Akacfa utcat valojaban csak KET jarat erinti (a 6-os es a
-- 14-es), viszont mindketto MINDKET iranyban megall ott, ezert a
-- halozat tablaban 4 sor tartozik hozza. A minta tehat a halozat
-- SORAIT szamolja, nem a kulonbozo jaratokat.
--
-- Ellenorizve mindket valtozatra:
--   count(*)              -> 83 sor, a minta mindharom sora egyezik
--   count(DISTINCT jarat) -> 30 sor, a minta egyik sora sem szerepel
--
-- Ezert a MINTA SZERINTI valtozatot adom megoldasnak (ezt ertekelik):
SELECT megallok.nev AS megallo, count(*) AS jaratokSzama
FROM megallok
JOIN halozat ON megallok.id = halozat.megallo
GROUP BY megallok.id, megallok.nev
HAVING count(*) >= 3;
-- Eredmeny: 83 megallo.
