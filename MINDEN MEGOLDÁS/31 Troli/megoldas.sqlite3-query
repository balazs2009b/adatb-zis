UPDATE jaratok SET elsoAjtos = 0 WHERE id = 20;

SELECT * FROM jaratok WHERE id = 20;
-- Eredmeny: 20 | 83 | T | 0   (az elsoAjtos 1-rol 0-ra valtozott)

