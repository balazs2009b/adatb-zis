-- --- Tiszta kiindulás (az újrafuttathatóságért) -----------
-- A 2. lecke végállapotát állítja vissza: evek 11 sorral,
-- Juhász Gyula évszámai még üresek.
DROP TABLE IF EXISTS masolat;
DROP TABLE IF EXISTS evek2;
DROP TABLE IF EXISTS evek;

CREATE TABLE evek (
    az INTEGER PRIMARY KEY,
    nev TEXT,
    szuletett INTEGER,
    meghalt INTEGER
  );
